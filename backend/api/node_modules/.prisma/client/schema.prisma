// Prisma schema for StreamStudio

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  name             String
  avatarUrl        String?
  subscriptionTier String   @default("free") // free, pro, enterprise
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  rooms        Room[]
  destinations Destination[]
  assets       Asset[]

  @@map("users")
}

model Room {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String?
  status      String    @default("draft") // draft, live, ended
  settings    Json      @default("{}")
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  participants Participant[]
  recordings   Recording[]

  @@index([userId])
  @@index([status])
  @@map("rooms")
}

model Participant {
  id          String    @id @default(uuid())
  roomId      String
  name        String
  inviteToken String?   @unique
  role        String    @default("guest") // host, cohost, guest
  status      String    @default("invited") // invited, waiting, admitted, disconnected
  joinedAt    DateTime?
  leftAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([inviteToken])
  @@map("participants")
}

model Destination {
  id        String   @id @default(uuid())
  userId    String
  platform  String // youtube, facebook, twitch, linkedin, custom
  name      String
  rtmpUrl   String
  streamKey String
  status    String   @default("idle") // idle, connecting, live, error
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("destinations")
}

model Recording {
  id         String   @id @default(uuid())
  roomId     String
  filename   String
  storageUrl String
  sizeBytes  BigInt?
  duration   Int? // in seconds
  status     String   @default("processing") // processing, ready, failed
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("recordings")
}

model Asset {
  id         String   @id @default(uuid())
  userId     String
  type       String // overlay, logo, background, sound
  filename   String
  storageUrl String
  sizeBytes  Int?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@map("assets")
}
